{
  "appId": "com.zenpawsdvm.client",
  "appName": "ZenPaws",
  "webDir": "www",
  "server": {
    "url": "https://app.zenpawsdvm.com/portal",
    "allowNavigation": [
      "app.zenpawsdvm.com"
    ],
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#F2F9FF"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#E8E4D6",
      "showSpinner": false
    }
  }
}
